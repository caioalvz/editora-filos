---
---
<header id="site-header">
  <div class="header-inner container">
    <a href="/" class="logo-link" aria-label="Filos Editora — página inicial">
      <img class="logo" src="/images/logo-white.webp" alt="Filos Editora" width="120" height="44" />
    </a>

    <nav class="desktop-nav" aria-label="Navegação principal">
      <a href="#servicos">Serviços</a>
      <a href="#sobre">Sobre</a>
      <a href="#depoimentos">Depoimentos</a>
      <a href="#faq">Perguntas</a>
      <a href="#contato">Contato</a>
    </nav>

    <div class="header-actions">
      <a
        href="https://wa.me/5514999256318?text=Olá%2C%20quero%20publicar%20meu%20livro%20com%20a%20Filos!"
        class="header-cta"
        target="_blank"
        rel="noopener"
      >
        Publicar meu livro
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
      </a>

      <button
        id="hamburger"
        class="hamburger"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav overlay (outside header so it isn't clipped) -->
<nav id="mobile-nav" class="mobile-nav" aria-label="Menu mobile" aria-hidden="true">
  <div class="mobile-nav-inner">
    <div class="mobile-links">
      <a href="#servicos"    class="mobile-link">Serviços</a>
      <a href="#sobre"       class="mobile-link">Sobre</a>
      <a href="#depoimentos" class="mobile-link">Depoimentos</a>
      <a href="#faq"         class="mobile-link">Perguntas</a>
      <a href="#contato"     class="mobile-link">Contato</a>
    </div>
    <a
      href="https://wa.me/5514999256318?text=Olá%2C%20quero%20publicar%20meu%20livro%20com%20a%20Filos!"
      class="btn-fill mobile-cta"
      target="_blank"
      rel="noopener"
    >
      Publicar meu livro
    </a>
  </div>
</nav>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: transparent;
    transition: background 0.4s var(--ease-out), border-color 0.4s var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  header.scrolled {
    background: rgba(13, 29, 48, 0.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 21px;
    height: 74px;
  }

  .logo-link { display: flex; align-items: center; flex-shrink: 0; }
  .logo { height: 36px; width: auto; }

  /* Desktop nav */
  .desktop-nav {
    display: flex;
    align-items: baseline;
    gap: 34px;
    margin-left: auto;
  }

  .desktop-nav a {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.65);
    transition: color var(--dur);
    letter-spacing: 0.01em;
  }

  .desktop-nav a:hover { color: #fff; }

  /* Header CTA */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 13px;
    flex-shrink: 0;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--f-display);
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--amber);
    border-bottom: 1px solid rgba(201, 144, 30, 0.35);
    padding-bottom: 2px;
    transition: color var(--dur), border-color var(--dur);
    letter-spacing: 0.01em;
  }

  .header-cta:hover { color: #e6a82a; border-color: rgba(201, 144, 30, 0.7); }

  .header-cta svg {
    width: 14px; height: 14px;
    fill: none; stroke: currentColor; stroke-width: 2;
    stroke-linecap: round; stroke-linejoin: round;
    transition: transform var(--dur);
  }

  .header-cta:hover svg { transform: translateX(3px); }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 10px 6px;
    z-index: 300;
    position: relative;
  }

  .bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 1px;
    transition: transform 0.35s var(--ease-out), opacity 0.25s, width 0.35s var(--ease-out);
    transform-origin: center;
  }

  .hamburger.open .bar-1 { transform: translateY(6.5px) rotate(45deg); }
  .hamburger.open .bar-2 { opacity: 0; transform: scaleX(0); }
  .hamburger.open .bar-3 { transform: translateY(-6.5px) rotate(-45deg); }

  /* Mobile nav overlay */
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: rgba(8, 16, 28, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 88px 40px 48px;

    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }

  .mobile-nav.open {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
  }

  .mobile-link {
    font-family: var(--f-head);
    font-weight: 300;
    font-size: clamp(1.9rem, 9vw, 2.8rem);
    color: rgba(255, 255, 255, 0.85);
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    letter-spacing: -0.015em;
    transition: color var(--dur), padding-left var(--dur);
  }

  .mobile-link:first-child { border-top: 1px solid rgba(255, 255, 255, 0.08); }
  .mobile-link:hover { color: var(--amber); padding-left: 8px; }

  .mobile-cta { align-self: flex-start; }

  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .header-cta  { display: none; }
    .hamburger   { display: flex; }
  }
</style>

<script>
  const header    = document.getElementById('site-header')!;
  const hamburger = document.getElementById('hamburger')!;
  const mobileNav = document.getElementById('mobile-nav')!;

  // Scroll: add frosted dark glass when past 60px
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 60);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Toggle overlay
  function openMenu() {
    mobileNav.classList.add('open');
    hamburger.classList.add('open');
    hamburger.setAttribute('aria-expanded', 'true');
    mobileNav.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileNav.classList.remove('open');
    hamburger.classList.remove('open');
    hamburger.setAttribute('aria-expanded', 'false');
    mobileNav.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  hamburger.addEventListener('click', () => {
    mobileNav.classList.contains('open') ? closeMenu() : openMenu();
  });

  // Close on link click or Escape
  document.querySelectorAll('.mobile-link, .mobile-cta').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
