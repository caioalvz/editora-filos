---

<section class="midia">
  <div class="container midia-inner">
    <header class="midia-head reveal">
      <h2 class="midia-titulo">A Filos na <em>mídia</em></h2>
      <p class="midia-sub">Presença nos maiores veículos do Brasil e do mundo</p>
    </header>

    <div class="midia-logos" aria-label="Veículos de mídia">
      {veiculos.map((v, i) => (
        <div class="midia-item reveal" style={`transition-delay:${i * 0.06}s`} title={v.nome}>
          <svg
            viewBox={`0 0 ${v.vw} ${v.vh}`}
            height="48"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            aria-hidden="true"
            style="display:block;width:auto;flex-shrink:0"
            set:html={v.svg}
          />
          <span class="midia-nome">{v.nome}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .midia {
    background: var(--navy);
    padding: clamp(55px, 7vw, 89px) 0;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .midia-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(32px, 4vw, 55px);
    text-align: center;
  }

  .midia-titulo {
    font-family: var(--f-head);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 300;
    letter-spacing: -0.01em;
    color: rgba(255,255,255,0.9);
    margin-bottom: 10px;
  }

  .midia-titulo em {
    font-style: italic;
    color: var(--amber);
  }

  .midia-sub {
    font-family: var(--f-display);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
  }

  .midia-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(24px, 4vw, 48px) clamp(32px, 5vw, 64px);
    width: 100%;
  }

  .midia-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    color: rgba(255,255,255,0.45);
    transition: color var(--dur) var(--ease-out);
    cursor: default;
  }

  .midia-item:hover { color: rgba(255,255,255,0.88); }

  .midia-nome {
    font-family: var(--f-display);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.22);
  }
</style>
