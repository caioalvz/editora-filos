---
---
<section class="hero" id="inicio">
  <!-- Imagem de fundo: asa + livros -->
  <div class="hero-img" aria-hidden="true">
    <img
      src="/images/hero-wings.jpg"
      alt=""
      class="hero-bg-photo"
      width="1920"
      height="1080"
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- Glifos flutuantes sutis sobre o overlay -->
  <div class="hero-glyphs" aria-hidden="true">
    <span class="glyph" style="top:12%;left:6%;font-size:6rem;animation-duration:62s;animation-delay:0s">¶</span>
    <span class="glyph" style="top:68%;left:8%;font-size:4rem;animation-duration:54s;animation-delay:-20s">§</span>
    <span class="glyph" style="top:20%;left:88%;font-size:5rem;animation-duration:70s;animation-delay:-35s">❧</span>
    <span class="glyph" style="top:75%;left:82%;font-size:3.5rem;animation-duration:48s;animation-delay:-12s">✻</span>
  </div>

  <!-- Conteúdo principal -->
  <div class="container hero-content">
    <p class="meta hero-kicker">Casa editorial para quem escreve sério</p>

    <h1 class="hero-h1">
      Dando asas<br />
      <em class="hero-em">à imaginação</em>
    </h1>

    <p class="prose hero-sub">
      Empresa brasileira que conecta literatura, tecnologia e impacto social.
      Do manuscrito ao livro publicado globalmente, em um único parceiro editorial.
    </p>

    <div class="hero-actions">
      <a
        href="https://wa.me/5581999999999?text=Olá%2C%20quero%20publicar%20meu%20livro%20com%20a%20Filos!"
        class="btn-fill hero-cta"
        target="_blank"
        rel="noopener"
      >
        Publicar meu livro
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
      </a>
      <a href="#servicos" class="hero-link">Ver serviços</a>
    </div>
  </div>

  <!-- Faixa de números -->
  <div class="hero-stats" aria-label="Filos em números">
    <div class="hstat">
      <span class="hstat-n">5.000<sup>+</sup></span>
      <span class="hstat-l">Títulos Publicados</span>
    </div>
    <div class="hstat">
      <span class="hstat-n">24</span>
      <span class="hstat-l">Estados do Brasil</span>
    </div>
    <div class="hstat">
      <span class="hstat-n">12<sup>+</sup></span>
      <span class="hstat-l">Países Alcançados</span>
    </div>
    <div class="hstat">
      <span class="hstat-n">15<sup>+</sup></span>
      <span class="hstat-l">Prefeituras Parceiras</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    overflow: hidden;
    margin-top: -74px;
    padding-top: 74px;
  }

  /* ── Imagem de fundo ── */
  .hero-img {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    filter: brightness(0.45) saturate(0.8);
  }

  /* overlay adicional para garantir legibilidade */
  .hero-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(8,14,28,0.55) 0%, rgba(8,14,28,0.2) 40%, rgba(8,14,28,0.65) 75%, rgba(8,14,28,0.88) 100%);
  }

  /* ── Glifos ── */
  .hero-glyphs {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .glyph {
    position: absolute;
    font-family: 'Spectral', Georgia, 'Times New Roman', serif;
    color: #fff;
    opacity: 0.04;
    line-height: 1;
    will-change: transform;
    animation-name: drift;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }

  @keyframes drift {
    0%   { transform: translate(0, 0) rotate(-3deg); }
    50%  { transform: translate(2vw, -2.5vh) rotate(2deg); }
    100% { transform: translate(-1.5vw, 2.5vh) rotate(-1.5deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph { animation: none; }
  }

  /* ── Conteúdo ── */
  .hero-content {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding-top: clamp(48px, 8vh, 96px);
    padding-bottom: clamp(48px, 6vh, 80px);
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-kicker {
    margin-bottom: var(--sp-3);
    color: rgba(255,255,255,0.45);
    font-style: italic;
  }

  .hero-h1 {
    font-size: clamp(3rem, 7vw, 5.8rem);
    font-weight: 300;
    color: #fff;
    line-height: 1.0;
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-4);
  }

  .hero-em {
    color: var(--amber);
    font-style: italic;
  }

  .hero-sub {
    max-width: 52ch;
    color: rgba(255,255,255,0.7);
    margin-bottom: var(--sp-4);
    font-size: 1.0625rem;
    line-height: 1.78;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .hero-cta {
    background: var(--amber);
    color: #fff;
  }

  .hero-cta:hover {
    background: #b8820d;
    transform: translateY(-1px);
  }

  .hero-link {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.75);
    border-bottom: 1px solid rgba(255,255,255,0.3);
    padding-bottom: 3px;
    transition: color var(--dur), border-color var(--dur);
  }

  .hero-link:hover {
    color: #fff;
    border-bottom-color: rgba(255,255,255,0.65);
  }

  /* ── Faixa de stats ── */
  .hero-stats {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: rgba(8, 14, 28, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .hstat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(20px, 3vh, 32px) clamp(12px, 2vw, 24px);
    border-right: 1px solid rgba(255,255,255,0.08);
  }

  .hstat:last-child { border-right: none; }

  .hstat-n {
    font-family: var(--f-display);
    font-size: clamp(1.6rem, 3.5vw, 2.8rem);
    font-weight: 700;
    color: var(--amber);
    line-height: 1;
    margin-bottom: 6px;
    letter-spacing: -0.02em;
  }

  .hstat-n sup {
    font-size: 0.55em;
    vertical-align: super;
    font-weight: 600;
  }

  .hstat-l {
    font-family: var(--f-display);
    font-size: 0.68rem;
    font-weight: 500;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  /* ── Responsivo ── */
  @media (max-width: 900px) {
    .hero-content { max-width: 100%; }
    .hero-h1 { font-size: clamp(2.6rem, 9vw, 4.2rem); }
  }

  @media (max-width: 600px) {
    .hero-stats { grid-template-columns: 1fr 1fr; }
    .hstat:nth-child(2) { border-right: none; }
    .hstat:nth-child(3),
    .hstat:nth-child(4) { border-top: 1px solid rgba(255,255,255,0.08); }
    .hero-actions { flex-direction: column; align-items: center; gap: var(--sp-3); }
  }
</style>
